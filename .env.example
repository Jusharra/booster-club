# Supabase -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://piqeuqiacmkyjneybjkg.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-or-publishable-key
# Service role key: server-only, never exposed to the client. Used by
# Stripe webhook handlers to write payment/subscription rows past RLS.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# App -------------------------------------------------------------------
# Public site origin, used to build absolute URLs (QR codes, SEO canonical
# links, Stripe redirect URLs). Set to the Netlify production URL / custom
# domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe -- platform account (Recruiting Profile subscriptions) --------
# Per the v1 architecture decision: Recruiting Profile subscription revenue
# flows to the PLATFORM's own Stripe account via Stripe Billing, separate
# from booster dues (which flow to the club's own Connect account below).
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# PLACEHOLDER pricing -- confirm real price before going live (see spec's
# "Content You'll Supply Separately" / Open Decisions). Values are in cents.
RECRUITING_PROFILE_PRICE_CENTS_MONTHLY=999
RECRUITING_PROFILE_PRICE_CENTS_ANNUAL=9900

# Stripe -- Connect (booster dues flow to the CLUB's own account, not the
# platform's) ------------------------------------------------------------
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_replace_me_connect

# Stripe -- platform flat fee billed directly to each Organization -------
PLATFORM_FEE_PRICE_ID=price_replace_me
